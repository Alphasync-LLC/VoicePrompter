# Private username accepted by the password sign-in endpoint.
# AUTH_USERNAME=todd

# Server-only scrypt password verifier, formatted as base64url salt:base64url derived key.
# Store this value in the hosting environment or Vaultwarden, never in source control.
# AUTH_PASSWORD_SCRYPT=

# Random server-only HMAC secret for signing sessions; use at least 32 random bytes.
# SESSION_SECRET=

# Private Convex service URL and admin credential used only for script persistence.
# CONVEX_PRIVATE_URL=
# CONVEX_ADMIN_KEY=

# Comma-separated exact production browser origins allowed to call this API.
# ALLOWED_ORIGINS=

# Port the gateway listens on (default: 8788).
# PORT=

# Session lifetime in seconds (default: 28800 / eight hours; maximum: 2592000).
# SESSION_TTL_SECONDS=

# Set to development only for explicit localhost development origins.
# NODE_ENV=development
